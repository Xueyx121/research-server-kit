# Copy to .env on the server and fill in the key for each provider you use.
# The selector defaults to Sorux. Switch with:
#   python scripts/use_provider.py sorux
#   python scripts/use_provider.py transformcat
LLM_PROVIDER=sorux

SORUX_API_KEY=
SORUX_BASE_URL=https://ai.soruxgpt.com/v1
SORUX_MODEL=gpt-6-sol

TRANSFORMCAT_API_KEY=
TRANSFORMCAT_BASE_URL=https://www.transformcat.cn/
TRANSFORMCAT_MODEL=gpt-6-sol

# Optional Hugging Face endpoint, only when a reachable and authorized mirror is available.
# HF_ENDPOINT=
