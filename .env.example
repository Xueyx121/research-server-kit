# Copy to .env on the server. Never commit real API keys.
# Default provider is Sorux. Switch locally with scripts/use_provider.py.
LLM_PROVIDER=sorux

SORUX_API_KEY=
SORUX_BASE_URL=https://ai.soruxgpt.com/v1
SORUX_MODEL=gpt-6-sol

TRANSFORMCAT_API_KEY=
TRANSFORMCAT_BASE_URL=https://www.transformcat.cn/
TRANSFORMCAT_MODEL=gpt-6-sol
